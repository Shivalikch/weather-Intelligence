# ---------------------------------------------------------------------------
# AFCENT Weather Intelligence SaaS - Prototype :: backend environment
# Copy this file to ".env" and adjust values for your local machine.
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME=AFCENT Weather Intelligence SaaS (Prototype)
APP_VERSION=0.1.0
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated list of allowed CORS origins (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Database connection.
#
# The whole application talks to the database ONLY through
# backend/database/database.py. To move this prototype to Oracle, MS SQL
# Server, PostgreSQL, etc. in the future, change DB_ENGINE + the connection
# fields below and update ONLY database.py -- nothing else in the codebase.
# ---------------------------------------------------------------------------
DB_ENGINE=sqlite
DB_NAME=weatherman.db

# Path is used by the sqlite engine only (relative to the backend/ folder).
DB_PATH=weatherman.db

# Reserved for future server-based engines (mssql / oracle / postgres).
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------------
# External API keys.
#
# MVP-1 runs fully on key-less public sources (Open-Meteo, NWS, NASA GIBS),
# so none of the below are required to run the prototype. They are wired here
# so registration-based sources (used by later MVPs) can be enabled without
# code changes. The env var NAME for each source is stored in the
# external_api.api_key_env column.
# ---------------------------------------------------------------------------
NASA_EARTHDATA_TOKEN=
COPERNICUS_CDS_KEY=
OPENWEATHER_API_KEY=
